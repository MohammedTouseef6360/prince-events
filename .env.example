# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Optional override (defaults to the live Firebase project)
FIREBASE_DATABASE_URL=https://prince-events-8bb83-default-rtdb.firebaseio.com

# REQUIRED for admin writes. Absolute path to the Firebase service-account
# private key JSON (Project Settings -> Service accounts -> Generate new private key).
# Server writes go through the Firebase Admin SDK, which bypasses database rules,
# so the DB stays locked for everyone else. Also copy the file to ./serviceAccountKey.json.
FIREBASE_SERVICE_ACCOUNT_KEY=
